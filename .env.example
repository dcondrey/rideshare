# ─── Required ────────────────────────────────────────────────────────────────

# Public URL where this app is served (used in magic-link emails).
APP_URL=http://localhost:3000

# Strong random secret used to sign session cookies and magic-link tokens.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Strong random secret used to HMAC attendee emails in the allowlist.
# Generate with:  openssl rand -hex 32
# WARNING: rotating this requires re-importing the attendee CSV.
ALLOWLIST_SALT=

# Comma-separated list of admin email addresses. Only these accounts can
# access /admin (after they sign in via the normal magic-link flow).
ADMIN_EMAILS=organizer@example.com

# ─── Email — pick ONE of the two options below ───────────────────────────────

# Option A: Resend (https://resend.com) — recommended. Free tier covers ~3k/mo.
RESEND_API_KEY=
EMAIL_FROM="Rideshare <noreply@example.com>"

# Option B: SMTP — bring your own server (Postmark, SES, Mailgun, Gmail, …)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false   # true = implicit TLS on port 465; false = STARTTLS on 587
# With SMTP_SECURE=false, STARTTLS is required: a server that does not offer it
# is refused rather than used in the clear. Set this only for a local relay
# (MailHog, Mailpit) that speaks no TLS at all.
# SMTP_ALLOW_PLAINTEXT=false

# ─── Optional ────────────────────────────────────────────────────────────────

# HTTP port. Default 3000.
PORT=3000

# SQLite file path. Default ./data/app.db.
# In Docker: mount a volume to /data and set DATABASE_PATH=/data/app.db.
DATABASE_PATH=./data/app.db

# Magic-link rate limit: max sends per email per hour. Default 5.
MAGIC_LINK_RATE_LIMIT=5

# Session lifetime in days. Default 14.
SESSION_LIFETIME_DAYS=14

# Trust proxy headers (X-Forwarded-Proto, X-Forwarded-For)? Default false.
# Set to true if running behind a reverse proxy (Cloudflare, nginx, Railway).
# The client address is read from the LAST X-Forwarded-For hop — the one your
# own proxy appended. Assumes exactly one proxy in front; behind two, the
# per-IP rate limit keys on the inner proxy rather than the visitor.
# Leaving this false behind a proxy puts every visitor in one rate-limit
# bucket; the server logs a warning the first time it sees the header.
TRUST_PROXY=false

# Deployment environment. Default "production" — leave it alone on a server.
# NODE_ENV=production

# Where the deployment's Ed25519 signing key is kept. Default ./secrets/deployment.key,
# created with mode 0600 on first boot. It is deliberately outside the database
# so `npm run backup` (SQLite only) never copies issuer key material.
# Keep it on the same persistent volume as the database — losing it invalidates
# every credential this deployment has issued.
# DEPLOYMENT_KEY_PATH=./secrets/deployment.key

# Alternative for hosts with no persistent disk: the key file's contents inline.
# Takes precedence over DEPLOYMENT_KEY_PATH. Treat as a secret of the same
# weight as SESSION_SECRET.
# DEPLOYMENT_KEY=

# Allow did:web resolution to fall back to plaintext HTTP for localhost and
# 127.0.0.1. Default false. This is a local-development knob only: it lets an
# unauthenticated caller make the server fetch arbitrary loopback ports, so it
# must never be set on a deployment that is reachable from anywhere else.
# ALLOW_INSECURE_DID_WEB=false
