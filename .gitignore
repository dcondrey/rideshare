# Dependencies
node_modules/

# Build output
.next/
out/
dist/
build/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Database (NEVER commit attendee data)
data/
*.db
*.db-journal
*.db-shm
*.db-wal

# Attendee/allowlist exports (PII — NEVER commit).
# These patterns are anchored to the repo root on purpose. Unanchored,
# `allowlist*` matched every path segment and silently excluded source files
# named after the feature — lib/allowlist.js and tests/unit/allowlist*.test.js
# were both missing from the repo, which broke CI's test and boot-smoke jobs
# on a clean checkout.
*.csv
/attendees*
/allowlist*

# Environment
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*

# OS
Thumbs.db
